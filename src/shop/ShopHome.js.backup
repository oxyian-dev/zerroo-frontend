                        px: { md: '80px', xs: '24px' },
                    }}
                >
                    <Grid container spacing={{ md: 4, xs: 3 }}>
                        {[
                            {
                                number: '10,000+',
                                label: 'Active Distributors',
                                description: 'Building their empires with Zerroo'
                            },
                            {
                                number: '₹50Cr+',
                                label: 'Earnings Distributed',
                                description: 'Empowering financial freedom'
                            },
                            {
